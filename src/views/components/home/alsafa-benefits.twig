{#
  Al Safa — Benefits of honey
  | Variable           | Type    | Description            |
  |--------------------|---------|------------------------|
  | component.title    | ?string | section title          |
  | component.lead     | ?string | intro paragraph        |
  | component.image    | ?string | arch photo             |
  | component.note     | ?string | small disclaimer       |
#}
{% set is_ar = theme.is_rtl %}
{% if is_ar %}
{% set items = [
  ['bolt',   'طاقة طبيعية',     'سكريات طبيعية تمنحك طاقة سريعة ومستدامة.'],
  ['shield', 'دعم المناعة',     'غني بمضادات الأكسدة والمركبات النباتية المفيدة.'],
  ['drop',   'تهدئة الحلق',     'ملعقة مع ماء دافئ تُلطّف الحلق وتريح السعال.'],
  ['sun',    'صحة الهضم',       'يُستخدم تقليديًا لتهدئة المعدة ودعم الهضم.'],
  ['heart',  'بديل صحي للسكر',  'حلاوة طبيعية لمشروباتك وأطباقك بدل السكر المكرر.'],
  ['leaf',   'جمال البشرة',     'مرطّب طبيعي يُستخدم في وصفات العناية التقليدية.']
] %}
{% else %}
{% set items = [
  ['bolt',   'Natural energy',     'Natural sugars for quick, lasting energy.'],
  ['shield', 'Immune support',     'Rich in antioxidants and beneficial plant compounds.'],
  ['drop',   'Soothes the throat', 'A spoonful in warm water calms the throat and eases coughs.'],
  ['sun',    'Digestive comfort',  'Traditionally used to settle the stomach and aid digestion.'],
  ['heart',  'A better sweetener', 'Natural sweetness for drinks and dishes instead of refined sugar.'],
  ['leaf',   'Skin care',          'A natural moisturiser used in traditional beauty recipes.']
] %}
{% endif %}
{% set icons = {
  'bolt':   '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/>',
  'shield': '<path d="M12 3 4 6v6c0 5 3.4 8.4 8 9 4.6-.6 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/>',
  'drop':   '<path d="M12 22c4 0 7-3 7-7 0-5-7-13-7-13S5 10 5 15c0 4 3 7 7 7Z"/>',
  'sun':    '<path d="M4 12a8 8 0 0 1 16 0"/><path d="M12 12v9"/><path d="M8 21h8"/><path d="M7 7l1.5 1.5M17 7l-1.5 1.5M12 4v2"/>',
  'heart':  '<path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z"/>',
  'leaf':   '<path d="M12 3c-1 4-6 5-6 10a6 6 0 0 0 12 0c0-5-5-6-6-10Z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>'
} %}
<section class="as as-section as-benefits" id="as-benefits" component-id="{{ componentId }}">
  <div class="as-container as-benefits-grid">
    <figure class="as-benefits-media as-reveal">
      <img src="{{ component.image ?: ('images/alsafa/mountain-honey.webp' | asset) }}" alt="" loading="lazy" width="1600" height="900">
      <figcaption class="as-stat-badge"><strong>100%</strong><span>{{ is_ar ? 'طبيعي وخام' : 'Natural & raw' }}</span></figcaption>
    </figure>

    <div class="as-benefits-copy">
      <p class="as-eyebrow">{{ is_ar ? 'فوائد العسل' : 'Benefits of honey' }}</p>
      <h2 class="as-h2">{{ component.title ?: (is_ar ? 'كنز الطبيعة الذهبي' : "Nature's Golden Treasure") }}</h2>
      <p class="as-section-lead">{{ component.lead ?: (is_ar
        ? 'عُرف العسل منذ القدم بفوائده العظيمة، وجاء ذكره في القرآن الكريم ﴿فِيهِ شِفَاءٌ لِلنَّاسِ﴾. إليك بعض ما يجعله جزءًا من يومك.'
        : "Honey has been treasured since ancient times, and the Holy Qur'an describes it as “in it is healing for people.” Here's why it belongs in your day.") }}</p>
      <ul class="as-benefit-list">
        {% for item in items %}
          <li class="as-reveal">
            {% set icon_key = item[0] %}
            <span class="as-b-icon"><svg aria-hidden="true" viewBox="0 0 24 24">{{ icons[icon_key] | raw }}</svg></span>
            <div><h3>{{ item[1] }}</h3><p>{{ item[2] }}</p></div>
          </li>
        {% endfor %}
      </ul>
      <p class="as-disclaimer">{{ component.note ?: (is_ar
        ? '* معلومات عامة وليست بديلًا عن الاستشارة الطبية. لا يُعطى العسل للأطفال دون عمر السنة.'
        : '* General information, not a substitute for medical advice. Do not give honey to infants under one year old.') }}</p>
    </div>
  </div>
</section>
