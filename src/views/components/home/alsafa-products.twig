{#
  Al Safa — Products (real Salla products, in the gold card design)
  | Variable           | Type                  | Description                      |
  |--------------------|-----------------------|----------------------------------|
  | component.title    | ?string               | section title                    |
  | component.lead     | ?string               | intro paragraph                  |
  | component.products | Product[] *Collection | products chosen in the dashboard |
#}
{% set is_ar = theme.is_rtl %}
<section class="as as-section as-shop" id="as-shop" component-id="{{ componentId }}">
  <div class="as-container">
    <header class="as-section-head as-reveal">
      <p class="as-eyebrow">{{ is_ar ? 'متجرنا' : 'Our shop' }}</p>
      <h2 class="as-h2">{{ component.title ?: (is_ar ? 'تشكيلة العسل الملكية' : 'The Royal Honey Collection') }}</h2>
      <p class="as-section-lead">{{ component.lead ?: (is_ar
        ? 'اختر منتجك وحجمه وادفع مباشرة بمدى وApple Pay والبطاقات — ونوصله لك أينما كنت.'
        : 'Pick your honey and size, then pay right here with Mada, Apple Pay or card — we deliver to your door.') }}</p>
    </header>

    <ul class="as-product-grid">
      {% for product in component.products %}
        {% set price = product.starting_price ?: product.price %}
        <li class="as-product">
          <a class="as-p-media" href="{{ product.url }}" aria-label="{{ product.name }}">
            {% if product.promotion_title %}<span class="as-p-badge">{{ product.promotion_title }}</span>{% endif %}
            <span class="as-p-jar"><img src="{{ product.image.url }}" alt="{{ product.image.alt ?: product.name }}" loading="lazy"></span>
            <span class="as-p-sparks" aria-hidden="true">{% for i in 1..10 %}<i></i>{% endfor %}</span>
          </a>
          <div class="as-p-body">
            <h3 class="as-p-name"><a href="{{ product.url }}">{{ product.name }}</a></h3>
            {% if product.subtitle %}<p class="as-p-desc">{{ product.subtitle }}</p>{% endif %}
            <div class="as-p-foot">
              <span class="as-p-price">
                {% if product.starting_price %}<small class="as-p-from">{{ is_ar ? 'يبدأ من' : 'From' }}</small>{% endif %}
                {% if product.is_on_sale and not product.starting_price %}
                  <span class="as-p-old">{{ product.regular_price | money }}</span>
                  {{ product.sale_price | money }}
                {% else %}
                  {{ price | money }}
                {% endif %}
              </span>
              <a class="as-btn as-btn-gold as-btn-sm" href="{{ product.url }}">
                {{ product.is_out_of_stock ? (is_ar ? 'نفدت الكمية' : 'Sold out') : (is_ar ? 'اختر الحجم واطلب' : 'Choose size & order') }}
              </a>
            </div>
          </div>
        </li>
      {% else %}
        <li class="as-empty">{{ is_ar ? 'اختر المنتجات التي تظهر هنا من إعدادات هذا القسم في لوحة سلة.' : 'Choose the products to show here in this section\'s settings in your Salla dashboard.' }}</li>
      {% endfor %}
    </ul>
  </div>
</section>
