{#
  Al Safa — What we do (two hexagon cards)
  | Variable          | Type    | Description         |
  |-------------------|---------|---------------------|
  | component.title   | ?string | section title       |
  | component.lead    | ?string | intro paragraph     |
#}
{% set is_ar = theme.is_rtl %}
<section class="as as-section as-promise" component-id="{{ componentId }}">
  <div class="as-container">
    <header class="as-section-head as-reveal">
      <p class="as-eyebrow">{{ is_ar ? 'ما نقدّمه' : 'What we do' }}</p>
      <h2 class="as-h2">{{ component.title ?: (is_ar ? 'طبيعي بالكامل، وبكل صدق' : 'All-natural, sincerely') }}</h2>
      <p class="as-section-lead">{{ component.lead ?: (is_ar
        ? 'من المنحل إلى الجرّة، نحرص على أن يصلكم العسل كما صنعه النحل تمامًا: نقيًّا، خامًا، وبلا أي إضافات.'
        : 'From hive to jar, we make sure our honey reaches you exactly as the bees made it: pure, raw and with nothing added.') }}</p>
    </header>
    <ul class="as-promise-grid">
      <li class="as-promise-card as-reveal">
        <div class="as-hex-photo"><img src="{{ 'images/alsafa/mountain-honey.webp' | asset }}" alt="" loading="lazy" width="1600" height="900"></div>
        <h3>{{ is_ar ? 'عسل خام 100٪' : '100% raw honey' }}</h3>
        <p>{{ is_ar ? 'غير مبستر وغير مُصفّى صناعيًا، يحتفظ بإنزيماته ونكهته الأصلية.' : 'Unpasteurised and never industrially filtered, keeping its enzymes and true flavour.' }}</p>
      </li>
      <li class="as-promise-card as-reveal">
        <div class="as-hex-photo is-badge"><img src="{{ 'images/alsafa/service-badge.webp' | asset }}" alt="" loading="lazy" width="480" height="554"></div>
        <h3>{{ is_ar ? 'رضاكم وعدنا' : 'Your Satisfaction Is Our Promise' }}</h3>
        <p>{{ is_ar ? 'نقدّم ضمانًا كاملًا على كل جرّة؛ إن لم يعجبكم العسل نستبدله لكم أو نعيد إليكم المبلغ كاملًا.' : "We stand behind every jar with a full guarantee — if you don't love your honey, we'll replace it or refund you in full." }}</p>
      </li>
    </ul>
  </div>
</section>
