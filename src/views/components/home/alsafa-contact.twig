{#
  Al Safa — Contact & location
  | Variable            | Type    | Description                          |
  |---------------------|---------|--------------------------------------|
  | component.phone     | ?string | call number, e.g. 0532401152         |
  | component.whatsapp  | ?string | WhatsApp number, e.g. 966510017007   |
  | component.address   | ?string | shop address                         |
  | component.maps_url  | ?string | Google Maps link for the shop        |
#}
{% set is_ar = theme.is_rtl %}
{% set phone = component.phone ?: '0532401152' %}
{% set wa = component.whatsapp ?: '966510017007' %}
{% set maps = component.maps_url ?: 'https://www.google.com/maps/place/%D9%85%D8%B1%D9%83%D8%B2+%D8%A7%D9%84%D8%B5%D9%81%D8%A7%D8%A1+%D9%84%D9%84%D8%B9%D8%B3%D9%84/@21.4860138,39.1915354,17z/data=!3m1!4b1!4m6!3m5!1s0x15c3cf1cbb63846b:0xd118372c97ee5892!8m2!3d21.4860138!4d39.1915354!16s%2Fg%2F11g1kt24n1' %}
<section class="as as-section as-contact" id="as-contact" component-id="{{ componentId }}">
  <div class="as-container">
    <header class="as-section-head as-reveal">
      <p class="as-eyebrow">{{ is_ar ? 'تواصل معنا' : 'Contact us' }}</p>
      <h2 class="as-h2">{{ is_ar ? 'زورونا في جدة التاريخية' : 'Visit Us in Historic Jeddah' }}</h2>
      <p class="as-section-lead">{{ is_ar ? 'يسعدنا استقبالكم في محلنا لتذوّق أنواع العسل، أو تواصلوا معنا عبر الهاتف أو واتساب.' : "We'd love to welcome you to our shop to taste our honey — or reach us by phone or WhatsApp." }}</p>
    </header>

    <div class="as-contact-grid">
      <div class="as-contact-cards">
        <a class="as-c-card" href="tel:{{ phone }}">
          <span class="as-c-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg></span>
          <span><span class="as-c-label">{{ is_ar ? 'اتصل بنا' : 'Call us' }}</span><strong dir="ltr">{{ phone }}</strong></span>
        </a>
        <a class="as-c-card" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
          <span class="as-c-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3.5 20.5 5 16a8.5 8.5 0 1 1 3.2 3.1l-4.7 1.4Z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 .9a5 5 0 0 1-2.8-2.8l.9-1-1-2L9 8.5Z"/></svg></span>
          <span><span class="as-c-label">{{ is_ar ? 'واتساب' : 'WhatsApp' }}</span><strong dir="ltr">+{{ wa }}</strong></span>
        </a>
        <a class="as-c-card" href="{{ maps }}" target="_blank" rel="noopener">
          <span class="as-c-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
          <span><span class="as-c-label">{{ is_ar ? 'العنوان' : 'Address' }}</span><strong>{{ component.address ?: (is_ar
            ? 'مركز الشعلة، محل رقم 11، باب مكة، طريق مكة المكرمة القديم، جدة التاريخية، جدة 22236'
            : "Markaz Alshu'la, Shop No. 11, Makkah Gate, Old Makkah Al Mukarramah Rd, Historic Jeddah, Jeddah 22236") }}</strong></span>
        </a>
        <div class="as-c-card as-hours">
          <span class="as-c-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <span class="as-hours-body">
            <span class="as-c-label">{{ is_ar ? 'ساعات العمل' : 'Opening hours' }}</span>
            <span class="as-hours-rows">
              <span><span>{{ is_ar ? 'الفترة الصباحية' : 'Morning' }}</span> <strong dir="ltr">{{ is_ar ? '8:30 ص – 2:00 م' : '8:30 AM – 2:00 PM' }}</strong></span>
              <span><span>{{ is_ar ? 'الفترة المسائية' : 'Evening' }}</span> <strong dir="ltr">{{ is_ar ? '4:30 م – 10:30 م' : '4:30 PM – 10:30 PM' }}</strong></span>
            </span>
            <span class="as-open-status" data-as-open-status data-open="{{ is_ar ? 'مفتوح الآن' : 'Open now' }}" data-closed="{{ is_ar ? 'مغلق الآن' : 'Closed now' }}" role="status"></span>
          </span>
        </div>
        <a class="as-btn as-btn-gold as-btn-block" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ is_ar ? 'راسلنا على واتساب' : 'Message us on WhatsApp' }}</a>
      </div>

      <div class="as-map-wrap">
        <iframe title="{{ is_ar ? 'خريطة موقع المحل' : 'Map of our shop' }}" src="https://maps.google.com/maps?q=21.4860138,39.1915354&z=17&hl={{ is_ar ? 'ar' : 'en' }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
