{#
  Al Safa — Hero (headline, two framed photos, flying bees)
  | Variable              | Type    | Description                         |
  |-----------------------|---------|-------------------------------------|
  | component.eyebrow     | ?string | small line above the title          |
  | component.title       | ?string | first line of the headline          |
  | component.title_gold  | ?string | second line (gold)                  |
  | component.lead        | ?string | paragraph under the headline        |
  | component.image_start | ?string | hexagon photo                       |
  | component.image_end   | ?string | arch photo                          |
  | component.cta_text    | ?string | main button text                    |
  | component.cta2_text   | ?string | second button text                  |
#}
{% set is_ar = theme.is_rtl %}
<section class="as as-hero" component-id="{{ componentId }}" aria-labelledby="as-hero-title-{{ position }}">
  <div class="as-honeycomb" aria-hidden="true"></div>
  <svg class="as-bee as-bee-1" aria-hidden="true" viewBox="0 0 64 48"><use href="#as-bee"/></svg>
  <svg class="as-bee as-bee-2" aria-hidden="true" viewBox="0 0 64 48"><use href="#as-bee"/></svg>
  <svg class="as-bee as-bee-3" aria-hidden="true" viewBox="0 0 64 48"><use href="#as-bee"/></svg>

  <div class="as-container as-hero-grid">
    <figure class="as-hero-media">
      <div class="as-hex-frame">
        <img src="{{ component.image_start ?: ('images/alsafa/honey-pour.webp' | asset) }}" alt="" width="844" height="503">
      </div>
    </figure>

    <div class="as-hero-copy">
      <p class="as-eyebrow">{{ component.eyebrow ?: (is_ar ? 'من الوادي إلى مائدتك' : 'From the valley to your table') }}</p>
      <h1 id="as-hero-title-{{ position }}" class="as-hero-title">
        {{ component.title ?: (is_ar ? 'عسل سدر أصيل' : 'Pure Sidr Honey,') }}<br>
        <span class="as-text-gold">{{ component.title_gold ?: (is_ar ? 'بحلاوة ملكية في كل قطرة' : 'Royal Sweetness in Every Drop') }}</span>
      </h1>
      <p class="as-lead">{{ component.lead ?: (is_ar
        ? 'في مركز الصفاء نقدّم لكم أجود عسل السدر الطبيعي الخام، نجمعه بعناية من مناحل وديان المملكة ونقدّمه لكم من قلب جدة التاريخية.'
        : "At Markaz Al Safa we bring you the finest raw, natural Sidr honey — carefully gathered from apiaries in the Kingdom's valleys and served from the heart of Historic Jeddah.") }}</p>
      <div class="as-ctas">
        <a class="as-btn as-btn-gold" href="#as-shop">{{ component.cta_text ?: (is_ar ? 'تسوّق الآن' : 'Shop now') }}</a>
        <a class="as-btn as-btn-ghost" href="#as-contact">{{ component.cta2_text ?: (is_ar ? 'زوروا محلنا' : 'Visit our store') }}</a>
      </div>
    </div>

    <figure class="as-hero-media">
      <div class="as-arch-frame">
        <img src="{{ component.image_end ?: ('images/alsafa/sidr-still-life.webp' | asset) }}" alt="" width="1600" height="900">
      </div>
    </figure>
  </div>

  {# Bee drawing used by the flying bees #}
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="as-bee" viewBox="0 0 64 48">
      <g class="as-bee-wing"><ellipse cx="22" cy="12" rx="11" ry="7" fill="rgba(255,240,200,.55)" stroke="#F5B82E" stroke-width="1.2" transform="rotate(-25 22 12)"/></g>
      <g class="as-bee-wing as-bee-wing-2"><ellipse cx="36" cy="10" rx="11" ry="7" fill="rgba(255,240,200,.45)" stroke="#F5B82E" stroke-width="1.2" transform="rotate(20 36 10)"/></g>
      <ellipse cx="31" cy="28" rx="17" ry="11" fill="#F5B82E"/>
      <path d="M24 18.5c-2 6-2 13 0 19M31 17c-2 7-2 15 0 22M38 18.5c-2 6-2 13 0 19" stroke="#140F08" stroke-width="3.2" fill="none"/>
      <circle cx="48" cy="26" r="6" fill="#140F08"/>
      <path d="M51 21c3-4 6-5 8-5M50 21c1-5 3-7 5-8" stroke="#140F08" stroke-width="1.4" fill="none" stroke-linecap="round"/>
      <path d="M14 28l-6 1" stroke="#140F08" stroke-width="2" stroke-linecap="round"/>
    </symbol>
  </svg>
</section>
